 interface StandingRowProps {
   entry: StandingEntry;
   isPole?: boolean;
+  sessionPhase?: SessionPhase;
+}
+
+function positionEvolution(entry: StandingEntry, sessionPhase?: SessionPhase): number | null {
+  if (
+    sessionPhase !== "race" ||
+    entry.startingPosition === null ||
+    entry.startingPosition === undefined ||
+    entry.startingPosition <= 0
+  ) {
+    return null;
+  }
+  return entry.startingPosition - entry.position;
+}
+
+function evolutionLabel(delta: number | null): string {
+  if (delta === null) return "—";
+  if (delta > 0) return `+${delta}`;
+  if (delta < 0) return `−${Math.abs(delta)}`;
+  return "0";
+}
+
+function formatFuel(fuelFraction: number | null | undefined): string {
+  if (
+    fuelFraction === null ||
+    fuelFraction === undefined ||
+    !Number.isFinite(fuelFraction) ||
+    fuelFraction < 0 ||
+    fuelFraction > 1
+  ) {
+    return "—";
+  }
+  return `${Math.round(fuelFraction * 100)} %`;
+}
+
+function statusPresentation(entry: StandingEntry): {
+  key: DriverStatus;
+  label: string;
+  className: string;
+} {
+  const key: DriverStatus = entry.inPit ? "pit" : entry.status;
+  switch (key) {
+    case "pit":
+      return {
+        key,
+        label: "Aux stands",
+        className: "border-slate-300/60 bg-slate-500/20 text-slate-100",
+      };
+    case "finished":
+      return {
+        key,
+        label: "Terminé",
+        className: "border-blue-300/50 bg-blue-500/15 text-blue-200",
+      };
+    case "dnf":
+    case "out":
+      return {
+        key,
+        label: "Abandon",
+        className: "border-red-400/50 bg-red-500/15 text-red-200",
+      };
+    case "running":
+    default:
+      return {
+        key: "running",
+        label: "En piste",
+        className: "border-emerald-400/50 bg-emerald-500/10 text-emerald-200",
+      };
+  }
+}
+
+function FuelMeter({ fuelFraction }: { fuelFraction?: number | null }) {
+  const formatted = formatFuel(fuelFraction);
+  if (formatted === "—") {
+    return (
+      <span
+        className="inline-flex rounded-md border border-slate-700/70 bg-slate-800/60 px-2 py-1 font-mono text-xs tabular-nums text-slate-500"
+        title="Carburant indisponible via le contrat natif"
+      >
+        N/D
+      </span>
+    );
+  }
+
+  const percentage = Math.round((fuelFraction ?? 0) * 100);
+  return (
+    <span
+      className="inline-flex min-w-[4.75rem] items-center gap-2 rounded-md border border-cyan-400/30 bg-cyan-400/[0.06] px-2 py-1 font-mono text-xs tabular-nums text-cyan-100"
+      aria-label={`Carburant ${formatted}`}
+    >
+      <span className="h-1.5 w-12 overflow-hidden rounded-full bg-slate-700/80" aria-hidden="true">
+        <span
+          className="block h-full rounded-full bg-cyan-300"
+          style={{ width: `${percentage}%` }}
+        />
+      </span>
+      {formatted}
+    </span>
+  );
+}
+
+function TelemetryUnavailable({ label }: { label: string }) {
